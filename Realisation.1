<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtVault | Historical Treasures</title>
    <link rel="stylesheet" href="style2.css">
</head>
<body>
<div class="app">
<!-- SIDEBAR -->
<aside class="sidebar">
    <a href="#dashboard" class="brand">
        <span class="brand-icon">A</span>
        <span>
            <strong>ARTVAULT</strong>
            <small>HISTORICAL ASSETS</small>
        </span>
    </a>

    <div class="profile">
        <div class="avatar">AV</div>
        <div>
            <strong>Collection privée</strong>
            <small>Administrateur</small>
        </div>
    </div>

    <p class="menu-title">MENU PRINCIPAL</p>

    <nav class="navigation">
        <a href="#dashboard" class="nav-link active">
            <span>▦</span> Tableau de bord
        </a>
        <a href="#collection" class="nav-link">
            <span>◇</span> Collection historique
        </a>
        <a href="#documents" class="nav-link">
            <span>▤</span> Documents & archives
        </a>
    </nav>

    <p class="menu-title">GESTION</p>

    <nav class="navigation">
        <a href="#acquisition" class="nav-link">
            <span>＋</span> Acquisition
        </a>
        <a href="#auction" class="nav-link">
            <span>♧</span> Enchères
        </a>
        <a href="#evaluation" class="nav-link">
            <span>◈</span> Évaluation
        </a>
        <a href="#vip" class="nav-link">
            <span>♛</span> Espace VIP
        </a>
    </nav>

    <div class="sidebar-bottom">
        <span class="status-dot"></span>
        Collection privée
        <small>Version 1.0</small>
    </div>
</aside>


<!-- MAIN CONTENT -->
<main class="main-content">

    <!-- TOPBAR -->
    <header class="topbar">
        <div>
            <p class="eyebrow">ESPACE DE GESTION PRIVÉ</p>
            <h1>ArtVault <span>Collection</span></h1>
        </div>

        <a href="#acquisition" class="top-button">
            + Nouvelle acquisition
        </a>
    </header>


    <!-- DASHBOARD -->
    <section id="dashboard" class="section dashboard-section">
        <div class="welcome-banner">
            <div class="welcome-content">
                <span class="gold-label">PATRIMOINE • HISTOIRE • SCIENCE</span>

                <h2>Préserver les témoins<br>
                    <span>de notre histoire.</span>
                </h2>

                <p>
                    Une collection dédiée aux objets historiques,
                    aux découvertes scientifiques et aux trésors
                    qui ont marqué les civilisations.
                </p>

                <a href="#collection" class="gold-button">
                    Explorer la collection →
                </a>
            </div>

            <div class="banner-decoration">
                <div class="circle circle-one"></div>
                <div class="circle circle-two"></div>
                <div class="banner-symbol">✧</div>
                <span>EST. 2026</span>
            </div>
        </div>


        <!-- STATS -->
        <div class="stats-grid">
            <article class="stat-card">
                <div class="stat-top">
                    <span>Pièces répertoriées</span>
                    <span class="stat-icon">◇</span>
                </div>
                <h3>08</h3>
                <p>Exemples de référence</p>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span>Époques représentées</span>
                    <span class="stat-icon">⌛</span>
                </div>
                <h3>08</h3>
                <p>De l'Antiquité à l'époque moderne</p>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span>Dossiers documentaires</span>
                    <span class="stat-icon">▤</span>
                </div>
                <h3>08</h3>
                <p>Fiches de référence</p>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span>Authentification</span>
                    <span class="stat-icon">✓</span>
                </div>
                <h3>Vérifié</h3>
                <p>Contrôle par des spécialistes</p>
            </article>
        </div>


        <!-- FEATURED COLLECTION -->
        <div class="section-heading">
            <div>
                <p class="eyebrow">SÉLECTION HISTORIQUE</p>
                <h2>Pièces remarquables</h2>
                <p class="section-description">
                    Des objets qui témoignent des connaissances
                    et des civilisations du passé.
                </p>
            </div>

            <a href="#collection" class="text-link">
                Voir la collection →
            </a>
        </div>

        <div class="collection-grid">

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://cdn.britannica.com/55/198155-050-4119014F/Parts-mechanism-trading-ship-Antikythera-device-wreck-1901.jpg" alt="Mécanisme d'Anticythère">
                    <span class="artifact-category">SCIENCE ANTIQUE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Grèce antique</span>
                        <span>IIe siècle av. J.-C.</span>
                    </div>
                    <h3>Mécanisme d'Anticythère</h3>
                    <p>Premier calculateur astronomique analogique témoignant d'un savoir mécanique exceptionnel.</p>
                    <div class="artifact-footer">
                        <span class="tag">Référence historique</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/2/23/Rosetta_Stone.JPG" alt="Pierre de Rosette">
                    <span class="artifact-category">ARCHÉOLOGIE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Égypte antique</span>
                        <span>196 av. J.-C.</span>
                    </div>
                    <h3>Pierre de Rosette</h3>
                    <p>Inscription trilingue essentielle dans le déchiffrement des hiéroglyphes.</p>
                    <div class="artifact-footer">
                        <span class="tag">Témoin linguistique</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://exploration.marinersmuseum.org/wp-content/uploads/sites/2/2013/12/1998.0039.000011.png" alt="Astrolabe historique">
                    <span class="artifact-category">ASTRONOMIE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Monde islamique</span>
                        <span>Moyen Âge</span>
                    </div>
                    <h3>Astrolabe historique</h3>
                    <p>Instrument scientifique utilisé pour étudier la position des astres et mesurer le temps.</p>
                    <div class="artifact-footer">
                        <span class="tag">Science médiévale</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://facsimile-editions.com/wp-content/uploads/2021/01/DSS-ISa_DSC6282-c2021.png" alt="Manuscrits de la mer Morte">
                    <span class="artifact-category">MANUSCRITS</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Proche-Orient</span>
                        <span>Antiquité</span>
                    </div>
                    <h3>Manuscrits de la mer Morte</h3>
                    <p>Témoins manuscrits majeurs pour l'étude des textes anciens et de leur transmission.</p>
                    <div class="artifact-footer">
                        <span class="tag">Patrimoine écrit</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/1/1f/Nofretete_Neues_Museum.jpg" alt="Buste de Néfertiti">
                    <span class="artifact-category">ART ÉGYPTIEN</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Égypte ancienne</span>
                        <span>1345 av. J.-C.</span>
                    </div>
                    <h3>Buste de Néfertiti</h3>
                    <p>Chef-d'œuvre sculptural de l'art amarnien représentant la grande reine égyptienne.</p>
                    <div class="artifact-footer">
                        <span class="tag">Sculpture royale</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6a/Mona_Lisa.jpg" alt="Mona Lisa">
                    <span class="artifact-category">PEINTURE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Italie / France</span>
                        <span>1503 - 1519</span>
                    </div>
                    <h3>La Joconde (Mona Lisa)</h3>
                    <p>Célèbre tableau de Léonard de Vinci, incarnation majeure de la peinture de la Renaissance.</p>
                    <div class="artifact-footer">
                        <span class="tag">Renaissance</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/51714-Terracota-Army.jpg/1280px-51714-Terracota-Army.jpg" alt="Armée de terre cuite">
                    <span class="artifact-category">ARCHÉOLOGIE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Chine ancienne</span>
                        <span>IIIe siècle av. J.-C.</span>
                    </div>
                    <h3>Armée de terre cuite</h3>
                    <p>Ensemble de sculptures funéraires représentant les troupes de Qin Shi Huang, premier empereur.</p>
                    <div class="artifact-footer">
                        <span class="tag">Patrimoine impérial</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

            <article class="artifact-card">
                <div class="artifact-image">
                    <img src="https://dist.phillips.com/auction-assets/NY080424/210952_001.jpg?fit=cover&offset-x=50&offset-y=100&width=928" alt="Montre de poche ancienne">
                    <span class="artifact-category">HORLOGERIE</span>
                </div>
                <div class="artifact-content">
                    <div class="artifact-meta">
                        <span>Époque moderne</span>
                        <span>Pièce unique</span>
                    </div>
                    <h3>Montre de poche ancienne</h3>
                    <p>Chef-d'œuvre de haute horlogerie en or finement ciselé et complications mécaniques.</p>
                    <div class="artifact-footer">
                        <span class="tag">Art horloger</span>
                        <a href="#documents">Détails ↗</a>
                    </div>
                </div>
            </article>

        </div>
    </section>


    <!-- COLLECTION -->
    <section id="collection" class="section content-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">INVENTAIRE DU PATRIMOINE</p>
                <h2>Collection historique</h2>
                <p class="section-description">
                    Classification des objets selon leur époque, leur provenance et leur importance.
                </p>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Objet</th>
                        <th>Catégorie</th>
                        <th>Époque</th>
                        <th>Importance</th>
                        <th>Dossier</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Mécanisme d'Anticythère</td>
                        <td>Science</td>
                        <td>Antiquité grecque</td>
                        <td><span class="importance">Exceptionnelle</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Pierre de Rosette</td>
                        <td>Archéologie</td>
                        <td>Égypte ancienne</td>
                        <td><span class="importance">Exceptionnelle</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Astrolabe historique</td>
                        <td>Astronomie</td>
                        <td>Moyen Âge</td>
                        <td><span class="importance">Majeure</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Manuscrits de la mer Morte</td>
                        <td>Manuscrits</td>
                        <td>Antiquité</td>
                        <td><span class="importance">Majeure</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Buste de Néfertiti</td>
                        <td>Art égyptien</td>
                        <td>Égypte ancienne</td>
                        <td><span class="importance">Exceptionnelle</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>La Joconde (Mona Lisa)</td>
                        <td>Peinture</td>
                        <td>Renaissance</td>
                        <td><span class="importance">Universelle</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Armée de terre cuite</td>
                        <td>Archéologie</td>
                        <td>Chine ancienne</td>
                        <td><span class="importance">Exceptionnelle</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                    <tr>
                        <td>Montre de poche ancienne</td>
                        <td>Horlogerie</td>
                        <td>Époque moderne</td>
                        <td><span class="importance">Majeure</span></td>
                        <td><a href="#documents">Consulter ↗</a></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="notice">
            Note : ces objets sont des exemples documentaires de référence. Leur présence dans cette interface ne signifie pas qu'ils appartiennent à une collection privée ou sont disponibles à l'achat.
        </p>
    </section>


    <!-- DOCUMENTS -->
    <section id="documents" class="section content-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ARCHIVES & AUTHENTICITÉ</p>
                <h2>Documents & dossiers</h2>
                <p class="section-description">
                    Informations essentielles pour étudier et documenter chaque objet historique.
                </p>
            </div>
        </div>

        <div class="document-grid">
            <article class="document-card">
                <div class="document-icon">▤</div>
                <div>
                    <h3>Fiche historique</h3>
                    <p>Époque, civilisation, contexte et description.</p>
                    <a href="#evaluation">Voir le modèle →</a>
                </div>
            </article>

            <article class="document-card">
                <div class="document-icon">⌕</div>
                <div>
                    <h3>Provenance</h3>
                    <p>Origine connue, historique de propriété et sources.</p>
                    <a href="#acquisition">Documenter →</a>
                </div>
            </article>

            <article class="document-card">
                <div class="document-icon">✓</div>
                <div>
                    <h3>Authentification</h3>
                    <p>Rapports d'experts et certificats disponibles.</p>
                    <a href="#evaluation">Examiner →</a>
                </div>
            </article>

            <article class="document-card">
                <div class="document-icon">◈</div>
                <div>
                    <h3>Rapport scientifique</h3>
                    <p>Études, références bibliographiques et analyses.</p>
                    <a href="#evaluation">Consulter →</a>
                </div>
            </article>
        </div>
    </section>


    <!-- ACQUISITION FORM -->
    <section id="acquisition" class="section content-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ENRICHISSEMENT DU PATRIMOINE</p>
                <h2>Nouvelle acquisition</h2>
                <p class="section-description">Enregistrer les informations d'un objet à étudier.</p>
            </div>
        </div>

        <form class="form-card" action="#acquisition" method="get">
            <div class="form-grid">
                <div class="form-group">
                    <label for="object-name">Nom de l'objet</label>
                    <input id="object-name" type="text" placeholder="Ex. Astrolabe ancien" required>
                </div>

                <div class="form-group">
                    <label for="category">Catégorie</label>
                    <select id="category" required>
                        <option value="">Choisir une catégorie</option>
                        <option>Archéologie</option>
                        <option>Manuscrits et archives</option>
                        <option>Instruments scientifiques</option>
                        <option>Art égyptien</option>
                        <option>Peinture</option>
                        <option>Horlogerie</option>
                        <option>Autre</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="period">Période historique</label>
                    <input id="period" type="text" placeholder="Ex. XIIe siècle">
                </div>

                <div class="form-group">
                    <label for="origin">Provenance</label>
                    <input id="origin" type="text" placeholder="Civilisation, région, pays">
                </div>

                <div class="form-group full-width">
                    <label for="significance">Importance historique ou scientifique</label>
                    <textarea id="significance" rows="4" placeholder="Décrire l'intérêt de l'objet..."></textarea>
                </div>

                <div class="form-group">
                    <label for="source">Sources documentaires</label>
                    <input id="source" type="text" placeholder="Référence, catalogue, étude">
                </div>

                <div class="form-group">
                    <label for="provenance">Justificatifs de provenance</label>
                    <select id="provenance">
                        <option>À vérifier</option>
                        <option>Documents disponibles</option>
                        <option>Provenance documentée</option>
                    </select>
                </div>
            </div>

            <button class="gold-button form-button" type="submit">
                Enregistrer la fiche
            </button>
        </form>
    </section>


    <!-- AUCTION FORM -->
    <section id="auction" class="section content-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">MARCHÉ & TRANSACTIONS</p>
                <h2>Suivi des enchères</h2>
                <p class="section-description">Préparer un dossier pour une vente ou une consultation.</p>
            </div>
        </div>

        <form class="form-card" action="#auction" method="get">
            <div class="form-grid">
                <div class="form-group">
                    <label for="auction-object">Objet concerné</label>
                    <input id="auction-object" type="text" placeholder="Nom de la pièce" required>
                </div>

                <div class="form-group">
                    <label for="auction-house">Maison de ventes</label>
                    <input id="auction-house" type="text" placeholder="Nom de l'organisme">
                </div>

                <div class="form-group">
                    <label for="estimate">Estimation indicative (€)</label>
                    <input id="estimate" type="number" min="0" placeholder="Montant estimé">
                </div>

                <div class="form-group">
                    <label for="auction-date">Date prévue</label>
                    <input id="auction-date" type="date">
                </div>

                <div class="form-group full-width">
                    <label for="auction-notes">Notes et références</label>
                    <textarea id="auction-notes" rows="4" placeholder="État du dossier, expert, catalogue..."></textarea>
                </div>
            </div>

            <button class="gold-button form-button" type="submit">
                Préparer le dossier
            </button>
        </form>
    </section>


    <!-- EVALUATION FORM -->
    <section id="evaluation" class="section content-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ANALYSE & EXPERTISE</p>
                <h2>Évaluation d'un objet</h2>
                <p class="section-description">Organiser les informations nécessaires à l'évaluation.</p>
            </div>
        </div>

        <form class="form-card" action="#evaluation" method="get">
            <div class="form-grid">
                <div class="form-group">
                    <label for="evaluation-object">Objet à évaluer</label>
                    <input id="evaluation-object" type="text" placeholder="Nom de l'objet" required>
                </div>

                <div class="form-group">
                    <label for="expert">Expert ou institution</label>
                    <input id="expert" type="text" placeholder="Nom de l'expert">
                </div>

                <div class="form-group">
                    <label for="authenticity">Statut d'authenticité</label>
                    <select id="authenticity">
                        <option>Non vérifié</option>
                        <option>Expertise en cours</option>
                        <option>Rapport disponible</option>
                        <option>Authenticité documentée</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="value">Estimation (€)</label>
                    <input id="value" type="number" min="0" placeholder="Montant estimé">
                </div>

                <div class="form-group full-width">
                    <label for="evaluation-notes">Rapport et justification</label>
                    <textarea id="evaluation-notes" rows="4" placeholder="État, rareté, provenance..."></textarea>
                </div>
            </div>

            <button class="gold-button form-button" type="submit">
                Préparer l'évaluation
            </button>
        </form>
    </section>


    <!-- VIP -->
    <section id="vip" class="section content-section">
        <div class="vip-banner">
            <div>
                <p class="eyebrow">ACCÈS PRIVÉ</p>
                <h2>Espace VIP</h2>
                <p>Organiser les demandes de consultation, les contacts professionnels et les visites privées.</p>
            </div>
            <div class="vip-symbol">♛</div>
        </div>

        <form class="form-card vip-form" action="#vip" method="get">
            <h3>Demande de consultation privée</h3>

            <div class="form-grid">
                <div class="form-group">
                    <label for="vip-name">Nom complet</label>
                    <input id="vip-name" type="text" placeholder="Votre nom" required>
                </div>

                <div class="form-group">
                    <label for="vip-email">Adresse e-mail</label>
                    <input id="vip-email" type="email" placeholder="nom@exemple.com" required>
                </div>

                <div class="form-group">
                    <label for="vip-subject">Type de demande</label>
                    <select id="vip-subject">
                        <option>Consultation documentaire</option>
                        <option>Expertise historique</option>
                        <option>Partenariat professionnel</option>
                        <option>Visite privée</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="vip-contact">Téléphone (facultatif)</label>
                    <input id="vip-contact" type="tel" placeholder="+212 ...">
                </div>

                <div class="form-group full-width">
                    <label for="vip-message">Message</label>
                    <textarea id="vip-message" rows="4" placeholder="Présentez votre demande..."></textarea>
                </div>
            </div>

            <button class="gold-button form-button" type="submit">
                Envoyer la demande
            </button>
        </form>
    </section>


    <!-- FOOTER -->
    <footer class="footer">
        <a href="#dashboard" class="footer-brand">ARTVAULT</a>
        <p>Préserver le passé. Documenter le présent. Transmettre l'histoire.</p>
        <span>© 2026 ArtVault — Interface de démonstration</span>
    </footer>

</main>
</div>
</body>
</html>
_____________________________________________________________________________________________________________________________
/* ==============================
ARTVAULT - STYLE PRINCIPAL
Noir / Or / Blanc
================================ */
:root {
  --bg: #0b0b0c;
  --panel: #141416;
  --panel-light: #1b1b1e;
  --border: #2b2b2e;
  --gold: #c7a66a;
  --gold-light: #e3ca91;
  --white: #f5f3ef;
  --muted: #96969c;
  --green: #7db99a;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

html {
  scroll-padding-top: 25px;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

/* APP LAYOUT */
.app {
  display: flex;
  min-height: 100vh;
}

/* FIXED SIDEBAR */
.sidebar {
  width: 255px;
  min-width: 255px;
  height: 100vh;
  position: sticky;
  top: 0;
  background: #101012;
  border-right: 1px solid var(--border);
  padding: 30px 18px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  z-index: 100;
}

.main-content {
  flex: 1;
  min-width: 0;
  padding: 30px 38px;
}

/* BRAND */
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 5px 28px;
  border-bottom: 1px solid var(--border);
}

.brand-icon {
  width: 42px;
  height: 42px;
  border: 1px solid var(--gold);
  color: var(--gold);
  display: grid;
  place-items: center;
  font-family: Georgia, serif;
  font-size: 27px;
}

.brand strong {
  display: block;
  font-size: 17px;
  letter-spacing: 3px;
}

.brand small {
  display: block;
  color: var(--gold);
  font-size: 9px;
  letter-spacing: 1.5px;
  margin-top: 3px;
}

/* PROFILE */
.profile {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 23px 4px;
}

.avatar {
  width: 39px;
  height: 39px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #29251d;
  border: 1px solid #5f4b2d;
  color: var(--gold-light);
  font-size: 12px;
  font-weight: bold;
}

.profile strong {
  display: block;
  font-size: 12px;
}

.profile small {
  color: var(--muted);
  font-size: 11px;
}

/* NAVIGATION */
.menu-title {
  color: #77777e;
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: bold;
  margin: 18px 10px 12px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px 13px;
  border-radius: 5px;
  color: #aaaab0;
  font-size: 12px;
  transition: 0.25s ease;
}

.nav-link span {
  width: 18px;
  text-align: center;
  font-size: 17px;
  color: var(--gold);
}

.nav-link:hover,
.nav-link.active {
  background: #28231a;
  color: var(--gold-light);
}

.sidebar-bottom {
  margin-top: auto;
  padding: 20px 7px 0;
  border-top: 1px solid var(--border);
  font-size: 11px;
  color: #c8c8cc;
}

.sidebar-bottom small {
  display: block;
  color: var(--muted);
  margin-top: 7px;
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: var(--green);
  border-radius: 50%;
  margin-right: 7px;
}

/* TOPBAR */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
}

.eyebrow {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: bold;
  margin-bottom: 7px;
}

.topbar h1 {
  font-size: clamp(24px, 3vw, 32px);
  letter-spacing: -1px;
}

.topbar h1 span {
  color: var(--gold);
}

.top-button {
  background: var(--gold);
  color: #17130c;
  padding: 12px 17px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
  transition: 0.25s;
}

.top-button:hover,
.gold-button:hover {
  background: var(--gold-light);
  transform: translateY(-2px);
}

/* SECTIONS */
.section {
  margin-bottom: 55px;
}

.content-section {
  padding-top: 35px;
  border-top: 1px solid var(--border);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin: 40px 0 22px;
}

.section-heading h2 {
  font-size: 24px;
  font-weight: 600;
}

.section-description {
  color: var(--muted);
  font-size: 12px;
  margin-top: 6px;
}

.text-link {
  color: var(--gold);
  font-size: 12px;
  white-space: nowrap;
}

.text-link:hover {
  color: var(--gold-light);
}

/* HERO */
.welcome-banner {
  position: relative;
  overflow: hidden;
  min-height: 300px;
  padding: 42px;
  border: 1px solid #453824;
  background: radial-gradient(circle at 85% 45%, rgba(168, 128, 63, 0.15), transparent 35%), linear-gradient(115deg, #191713, #111112 65%);
  display: flex;
  align-items: center;
}

.welcome-content {
  position: relative;
  z-index: 2;
  max-width: 530px;
}

.gold-label {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
}

.welcome-banner h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(32px, 4vw, 49px);
  font-weight: normal;
  line-height: 1.18;
  margin: 15px 0;
}

.welcome-banner h2 span {
  color: var(--gold-light);
  font-style: italic;
}

.welcome-banner p {
  color: #b0afb0;
  max-width: 420px;
  font-size: 12px;
  line-height: 1.9;
  margin-bottom: 23px;
}

.gold-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  border: none;
  cursor: pointer;
  background: var(--gold);
  color: #17130c;
  padding: 13px 18px;
  border-radius: 3px;
  font-size: 12px;
  font-weight: bold;
  transition: 0.25s ease;
}

.banner-decoration {
  position: absolute;
  width: 290px;
  height: 290px;
  right: 4%;
  top: 50%;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  color: var(--gold);
}

.circle {
  position: absolute;
  border: 1px solid rgba(199, 166, 106, 0.3);
  border-radius: 50%;
}

.circle-one {
  width: 230px;
  height: 230px;
}

.circle-two {
  width: 180px;
  height: 180px;
  border-style: dashed;
  animation: rotate 40s linear infinite;
}

.banner-symbol {
  font-size: 100px;
  font-family: Georgia, serif;
  opacity: 0.8;
}

.banner-decoration span {
  position: absolute;
  bottom: 0;
  font-size: 9px;
  letter-spacing: 4px;
  color: #8c7854;
}

@keyframes rotate {
  to {
    transform: rotate(360deg);
  }
}

/* STATS */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-top: 20px;
}

.stat-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 19px;
  transition: 0.25s;
}

.stat-card:hover {
  border-color: #725b37;
  transform: translateY(-3px);
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  color: #aaaab0;
  font-size: 11px;
}

.stat-icon {
  color: var(--gold);
  font-size: 20px;
}

.stat-card h3 {
  font-size: 27px;
  margin: 13px 0 5px;
  color: var(--white);
}

.stat-card p {
  color: var(--muted);
  font-size: 10px;
}

/* COLLECTION CARDS */
.collection-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.artifact-card {
  min-width: 0;
  overflow: hidden;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 5px;
  transition: 0.3s ease;
}

.artifact-card:hover {
  transform: translateY(-5px);
  border-color: #76603d;
}

.artifact-image {
  height: 190px;
  position: relative;
  overflow: hidden;
  background: #24211b;
}

.artifact-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: brightness(0.78) saturate(0.75);
  transition: 0.4s ease;
}

.artifact-card:hover .artifact-image img {
  transform: scale(1.06);
  filter: brightness(0.95) saturate(0.9);
}

.artifact-category {
  position: absolute;
  left: 12px;
  top: 12px;
  padding: 6px 9px;
  background: rgba(12, 12, 12, 0.85);
  color: var(--gold-light);
  font-size: 9px;
  letter-spacing: 1px;
  border: 1px solid rgba(199, 166, 106, 0.4);
}

.artifact-content {
  padding: 18px;
}

.artifact-meta {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6px;
  color: var(--muted);
  font-size: 10px;
}

.artifact-content h3 {
  font-size: 16px;
  margin: 12px 0 8px;
  line-height: 1.4;
}

.artifact-content > p {
  color: #a4a4aa;
  font-size: 11px;
  line-height: 1.8;
  min-height: 60px;
}

.artifact-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: 14px;
}

.tag {
  color: var(--gold);
  background: #29241b;
  padding: 5px 7px;
  font-size: 9px;
  border-radius: 3px;
}

.artifact-footer a,
table a {
  color: var(--gold-light);
  font-size: 10px;
}

/* TABLE */
.table-wrapper {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 5px;
}

table {
  width: 100%;
  min-width: 680px;
  border-collapse: collapse;
  text-align: left;
  background: var(--panel);
}

thead {
  background: #1b1a18;
}

th {
  color: var(--gold-light);
  font-size: 10px;
  letter-spacing: 0.5px;
  font-weight: 600;
}

th,
td {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

td {
  color: #c7c7cc;
  font-size: 11px;
}

tbody tr:last-child td {
  border-bottom: none;
}

tbody tr {
  background: #1b1a17;
}

.importance {
  color: var(--gold-light);
  background: #29241b;
  border: 1px solid #463a25;
  padding: 5px 8px;
  border-radius: 3px;
  font-size: 10px;
  white-space: nowrap;
}

.notice {
  color: #aaa6a0;
  font-size: 11px;
  line-height: 1.8;
  border-left: 2px solid var(--gold);
  padding: 12px 15px;
  margin-top: 16px;
  background: #171613;
}

/* DOCUMENTS */
.document-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.document-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 23px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 5px;
  transition: 0.25s;
}

.document-card:hover {
  border-color: #725b37;
}

.document-icon {
  width: 43px;
  min-width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: #29241b;
  border: 1px solid #4e402a;
  color: var(--gold);
  font-size: 21px;
}

.document-card h3 {
  font-size: 14px;
  margin-bottom: 5px;
}

.document-card p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.8;
  margin-bottom: 12px;
}

.document-card a {
  color: var(--gold);
  font-size: 11px;
}

/* FORMS */
.form-card {
  padding: 28px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 5px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.form-group label {
  color: #d0d0d4;
  font-size: 11px;
  font-weight: 600;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  min-width: 0;
  background: #0e0e10;
  color: var(--white);
  border: 1px solid #343438;
  border-radius: 4px;
  padding: 13px 14px;
  font-size: 12px;
  outline: none;
  transition: 0.2s;
}

.form-group input,
.form-group select {
  min-height: 44px;
}

.form-group textarea {
  resize: vertical;
  min-height: 100px;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #77777d;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 2px rgba(199, 166, 106, 0.08);
}

.form-group select {
  color-scheme: dark;
}

.full-width {
  grid-column: 1 / -1;
}

.form-button {
  margin-top: 24px;
}

/* VIP */
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  background: radial-gradient(circle at 85% 50%, #382c1b, transparent 35%), #171511;
  border: 1px solid #57452b;
  padding: 35px;
  margin-bottom: 22px;
}

.vip-banner h2 {
  font-family: Georgia, serif;
  font-size: 32px;
  font-weight: normal;
  margin: 8px 0;
}

.vip-banner p {
  color: #b0afb0;
  font-size: 12px;
  max-width: 540px;
  line-height: 1.9;
}

.vip-symbol {
  color: var(--gold);
  font-size: 70px;
  padding: 0 20px;
}

.vip-form h3 {
  font-size: 16px;
  margin-bottom: 25px;
}

/* FOOTER */
.footer {
  border-top: 1px solid var(--border);
  padding: 28px 0;
  text-align: center;
}

.footer-brand {
  color: var(--gold);
  letter-spacing: 4px;
  font-size: 14px;
  font-weight: bold;
}

.footer p {
  color: #aaaab0;
  font-size: 11px;
  margin: 9px 0;
}

.footer span {
  color: #77777d;
  font-size: 10px;
}

/* RESPONSIVE TABLET */
@media (max-width: 1200px) {
  .sidebar {
    width: 220px;
    min-width: 220px;
  }
  .main-content {
    padding: 25px;
  }
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .collection-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .banner-decoration {
    right: -60px;
    opacity: 0.6;
  }
}

/* RESPONSIVE MOBILE */
@media (max-width: 760px) {
  .app {
    display: block;
  }
  .sidebar {
    width: 100%;
    min-width: 0;
    height: auto;
    position: static;
    padding: 18px;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    padding-bottom: 17px;
  }
  .profile,
  .menu-title,
  .sidebar-bottom {
    display: none;
  }
  .navigation {
    flex-direction: row;
    overflow-x: auto;
    gap: 7px;
    padding: 12px 0 3px;
  }
  .navigation + .menu-title {
    display: none;
  }
  .nav-link {
    flex: 0 0 auto;
    padding: 10px 12px;
    border: 1px solid var(--border);
    font-size: 11px;
  }
  .main-content {
    padding: 20px 15px;
  }
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 22px;
  }
  .top-button {
    width: 100%;
    text-align: center;
  }
  .welcome-banner {
    padding: 28px 22px;
    min-height: 320px;
  }
  .welcome-banner h2 {
    font-size: 34px;
  }
  .welcome-content {
    max-width: 100%;
  }
  .banner-decoration {
    right: -150px;
    opacity: 0.25;
  }
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .stat-card {
    padding: 14px;
  }
  .stat-top {
    font-size: 10px;
  }
  .stat-card h3 {
    font-size: 23px;
  }
  .collection-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  .artifact-image {
    height: 220px;
  }
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-top: 30px;
  }
  .section-heading h2 {
    font-size: 22px;
  }
  .document-grid {
    grid-template-columns: 1fr;
  }
  .form-card {
    padding: 20px 15px;
  }
  .form-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .full-width {
    grid-column: auto;
  }
  .vip-banner {
    padding: 25px 20px;
  }
  .vip-banner h2 {
    font-size: 27px;
  }
  .vip-symbol {
    font-size: 43px;
    padding: 0;
  }
  .footer p {
    line-height: 1.8;
  }
}

/* SMALL MOBILE */
@media (max-width: 380px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
  .welcome-banner h2 {
    font-size: 29px;
  }
  .artifact-image {
    height: 180px;
  }
  .vip-symbol {
    display: none;
  }
}

/* ACCESSIBILITY */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--gold-light);
  outline-offset: 3px;
}

/* REDUCED MOTION */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
