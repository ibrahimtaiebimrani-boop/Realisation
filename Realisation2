:root {
  --bg: #0b0b0c;
  --border: #2b2b2e;
  --gold: #c7a66a;
  --gold-light: #e3ca91;
  --white: #f5f3ef;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.main-content {
  max-width: 1100px;
  margin: 0 auto;
  padding: 30px 20px;
}

/* TOPBAR */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
}

.eyebrow {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: bold;
  margin-bottom: 7px;
}

.topbar h1 {
  font-size: 32px;
  letter-spacing: -1px;
}

.topbar h1 span {
  color: var(--gold);
}

.top-button,
.gold-button {
  background: var(--gold);
  color: #17130c;
  padding: 12px 18px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
  display: inline-block;
  transition: 0.25s ease;
}

.top-button:hover,
.gold-button:hover {
  background: var(--gold-light);
  transform: translateY(-2px);
}

/* HERO BANNER */
.welcome-banner {
  position: relative;
  overflow: hidden;
  min-height: 300px;
  padding: 42px;
  border: 1px solid #453824;
  border-radius: 6px;
  background: radial-gradient(circle at 85% 45%, rgba(168, 128, 63, 0.15), transparent 35%),
              linear-gradient(115deg, #191713, #111112 65%);
  display: flex;
  align-items: center;
}

.welcome-content {
  position: relative;
  z-index: 2;
  max-width: 530px;
}

.gold-label {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
}

.welcome-banner h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42px;
  font-weight: normal;
  line-height: 1.18;
  margin: 15px 0;
}

.welcome-banner h2 span {
  color: var(--gold-light);
  font-style: italic;
}

.welcome-banner p {
  color: #b0afb0;
  max-width: 420px;
  font-size: 12px;
  line-height: 1.9;
  margin-bottom: 23px;
}

.banner-decoration {
  position: absolute;
  width: 290px;
  height: 290px;
  right: 4%;
  top: 50%;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  color: var(--gold);
}

.circle {
  position: absolute;
  border: 1px solid rgba(199, 166, 106, 0.3);
  border-radius: 50%;
}

.circle-one {
  width: 230px;
  height: 230px;
}

.circle-two {
  width: 180px;
  height: 180px;
  border-style: dashed;
}

.banner-symbol {
  font-size: 80px;
  font-family: Georgia, serif;
  opacity: 0.8;
}

.banner-decoration span {
  position: absolute;
  bottom: 0;
  font-size: 9px;
  letter-spacing: 4px;
  color: #8c7854;
}
