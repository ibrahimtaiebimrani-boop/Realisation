<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtVault Collection</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">
            <div>
                <p class="eyebrow">ESPACE DE GESTION PRIVÉ</p>
                <h1>ArtVault <span>Collection</span></h1>
            </div>

            <a href="#acquisition" class="top-button">
                + Nouvelle acquisition
            </a>
        </header>

        <!-- HERO BANNER -->
        <section class="welcome-banner">
            <div class="welcome-content">
                <span class="gold-label">PATRIMOINE • HISTOIRE • SCIENCE</span>

                <h2>Préserver les témoins<br>
                    <span>de notre histoire.</span>
                </h2>

                <p>
                    Une collection dédiée aux objets historiques,
                    aux découvertes scientifiques et aux trésors
                    qui ont marqué les civilisations.
                </p>

                <a href="#collection" class="gold-button">
                    Explorer la collection →
                </a>
            </div>

            <div class="banner-decoration">
                <div class="circle circle-one"></div>
                <div class="circle circle-two"></div>
                <div class="banner-symbol">✧</div>
                <span>EST. 2026</span>
            </div>
        </section>

    </main>

</body>
</html>
